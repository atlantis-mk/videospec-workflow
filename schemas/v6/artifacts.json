{
  "templateVersion": 6,
  "artifacts": {
    "context.md": { "template": "videospec/context", "requiredHeadings": ["## Current review context", "## Confirmed facts and sources", "## Decisions and rationale", "## Risks and unresolved items", "## Change log"], "allowedHeadingPatterns": ["^# Context ledger: .+$"] },
    "brief.md": { "template": "videospec/brief", "requiredHeadings": ["## Audience problem and opportunity", "## Angle slate", "## Selected promise and editorial decision", "## Retention map", "## Anti-boredom constraints and success hypothesis", "## Evidence and uncertainty boundary"], "allowedHeadingPatterns": ["^# Production brief: .+$", "^### Beat B[0-9]{3}$"] },
    "evidence.md": { "template": "videospec/evidence", "requiredHeadings": ["## Reference inputs and requested use", "## Script authority and adaptation boundary", "## Material coverage map", "## Evidence log", "## Counterevidence, caveats, and examples", "## Open evidence decisions"], "allowedHeadingPatterns": ["^# Evidence ledger: .+$", "^### (Reference|Evidence) [RE][0-9]{3}$"] },
    "script.md": { "template": "videospec/script", "requiredHeadings": ["## Summary", "## TTS configuration", "## Voice profile"], "allowedHeadingPatterns": ["^# Script: .+$", "^## [0-9]{2,}:[0-9]{2}(?:\\.[0-9]{3})?[–-][0-9]{2,}:[0-9]{2}(?:\\.[0-9]{3})?｜.+$"] },
    "content-review.md": { "template": "videospec/content-review", "requiredHeadings": ["## Review scope", "## Reference fidelity review", "## Script authority audit", "## Fictional narrative boundary", "## Brief fidelity", "## Editorial opposition", "## Voice and self-media audit", "## Retention and clarity analysis", "## Strict scorecard", "## Likely exit point", "## Fact and risk analysis", "## Required revisions and resolutions", "## Strengths to preserve", "## Reviewer verdict", "## Ready for human content review"], "allowedHeadingPatterns": ["^# AI content review: .+$"] },
    "storyboard.md": { "template": "videospec/storyboard", "requiredHeadings": ["## Director's rules", "## Scenes"], "allowedHeadingPatterns": ["^# Storyboard: .+$", "^### Scene S[0-9]{3}$", "^#### (Visual beat and attention|Visual composition|Motion and transition|Audio|Acceptance check)$"] },
    "materials.md": { "template": "videospec/materials", "requiredHeadings": ["## Assets"], "allowedHeadingPatterns": ["^# Materials plan: .+$", "^### Asset MAT-[0-9]{3}$", "^#### Intended use$"] },
    "tasks.md": { "template": "videospec/tasks", "requiredHeadings": ["## Pre-production", "## TTS and video build", "## Automated quality control", "## Publication and learning"], "allowedHeadingPatterns": ["^# Production tasks: .+$"] },
    "review.md": { "template": "videospec/review", "requiredHeadings": ["## Review version", "## Automated checks", "## Audience critic review", "## Findings and resolutions", "## Human final checklist"], "allowedHeadingPatterns": ["^# Automated video review: .+$"] },
    "publish.md": { "template": "videospec/publish", "requiredHeadings": ["## Platform and schedule", "## Title variants and selected title", "## Cover / thumbnail", "## Description and metadata", "## Ten publication tags", "## Publication checklist"], "allowedHeadingPatterns": ["^# Publication package: .+$"] },
    "learning.md": { "template": "videospec/learning", "requiredHeadings": ["## Publication record and measurement window", "## Raw metrics and data quality", "## Outcome versus brief hypothesis", "## What worked", "## What to change", "## Recommended next experiments", "## Durable standards candidates"], "allowedHeadingPatterns": ["^# Post-publication learning: .+$"] }
  }
}
